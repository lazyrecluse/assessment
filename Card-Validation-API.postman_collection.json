{
  "info": {
    "_postman_id": "c1f7a83d-9b2e-4e3a-872f-584a29a12345",
    "name": "Card Validation API",
    "description": "Postman Collection for testing the Card Validation API endpoint (Luhn algorithm, edge cases, and HTTP error handling).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response returns status ok', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Validation - Valid Visa Card",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardNumber\": \"4532015112830366\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cards/validate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cards", "validate"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Card is valid (isValid: true)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.isValid).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
